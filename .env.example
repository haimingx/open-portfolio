# Everything here is optional. The app runs without any configuration.

# Chaintable API key. Without it, requests are anonymous and limited per IP.
# Never prefix it with NEXT_PUBLIC_.
CHAINTABLE_API_KEY=

# Redis for the trending ranking. Vercel adds the KV_* pair when you connect
# Upstash for Redis with an empty Custom Prefix. Use the UPSTASH_* pair for a
# database created directly on Upstash.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated addresses to keep off the ranking.
TRENDING_EXCLUDE=
